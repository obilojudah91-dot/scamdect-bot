# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_IDS=6516581293  # comma-separated numeric Telegram user IDs
TELEGRAM_USE_WEBHOOK=true      # true for Render deployment (webhook mode)
TELEGRAM_WEBHOOK_URL=https://your-app-name.onrender.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here

# Database (PostgreSQL - use Supabase or Render Postgres)
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis (optional for production rate limiting)
REDIS_URL=redis://host:port  # leave blank to use in-memory limiter

# Application Settings
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Future ScamDect platform integration
SCAMDECT_API_URL=
SCAMDECT_API_KEY=
