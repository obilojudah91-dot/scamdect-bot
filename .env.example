# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=            # comma-separated numeric Telegram user IDs, e.g. 123456789,987654321
TELEGRAM_USE_WEBHOOK=false     # false = polling (simplest for early deployment)
TELEGRAM_WEBHOOK_URL=          # required only if TELEGRAM_USE_WEBHOOK=true
TELEGRAM_WEBHOOK_SECRET=       # required only if TELEGRAM_USE_WEBHOOK=true

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/scamdect_bot

# Redis (optional but recommended for production rate limiting)
REDIS_URL=                     # leave blank to fall back to in-memory limiter (single-instance only)

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Future ScamDect platform integration (leave blank until you wire ScamDectApiProvider)
SCAMDECT_API_URL=
SCAMDECT_API_KEY=
